# KingVision Fitness — Backend environment template
# Copy to .env and fill in. The server validates these at boot via src/config/env.ts
# and refuses to start if required values are missing or use legacy placeholders.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:5001

# ── Database (required) ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/kingvision-fitness

# ── JWT (required) ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production: min 32 chars. Dev: min 16 chars. Legacy placeholders are rejected.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

# Access tokens are short-lived; the frontend silently refreshes via the
# long-lived refresh token (httpOnly-cookie auth is the next migration).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Stripe (optional until billing ships) ──────────────────────────────────────
# If STRIPE_SECRET_KEY is set, STRIPE_WEBHOOK_SECRET MUST also be set.
# Production also requires STRIPE_PRICE_ID_* when STRIPE_SECRET_KEY is set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_SPECIFIED=price_...
# STRIPE_PRICE_ID_ACTIVE_CLIENT=price_...
# Mobile deep links (defaults used if unset):
# STRIPE_SUCCESS_URL=kingvisionfitness://billing/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=kingvisionfitness://billing/cancel

# ── Dev-only billing bypass ────────────────────────────────────────────────────
# Requires ALLOW_DEV_BYPASS=true AND DEV_BYPASS_SECRET (NODE_ENV != production).
# Frontend reads DEV_BYPASS_SECRET from EXPO_PUBLIC_DEV_BYPASS_SECRET.
# ALLOW_DEV_BYPASS=true
# DEV_BYPASS_SECRET=

# ── Optional feature flags ─────────────────────────────────────────────────────
# ENABLE_COACH_IN_POCKET_SOCKETS=true
# ENABLE_ML_INFERENCE=true

# ── Email ──────────────────────────────────────────────────────────────────────
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@kingvisionfitness.com

# ── Cloudinary ─────────────────────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
